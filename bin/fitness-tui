#!/usr/bin/env python3
"""
fitness-tui — Interaktives Textual TUI für Session-Logs.

Kein Server nötig — direkter Dateizugriff auf:
  ~/.aos/users/<uid>/fitness/sessions/*.json

Keyboard:
  1/2/3/4/5 → Tabs (Log · Woche · Stats · Sync · Clients)
  j / ↓     → nächste Session
  k / ↑     → vorherige Session
  Enter      → Detail-Panel öffnen/schließen
  r          → Daten neu laden
  q / Ctrl+C → Beenden
"""
from __future__ import annotations

import json
import sqlite3
import subprocess
from datetime import date, datetime, timedelta
from pathlib import Path
from typing import ClassVar

from textual import on, work
from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.containers import Container, Horizontal, ScrollableContainer, Vertical
from textual.reactive import reactive
from textual.screen import ModalScreen
from textual.widget import Widget
from textual.widgets import (
    DataTable, Footer, Header, Label, ListItem, ListView,
    ProgressBar, Rule, Static, TabbedContent, TabPane,
)

# ── Pfade ─────────────────────────────────────────────────────────────────────
_REPO     = Path(__file__).resolve().parent.parent
_uid_file = Path.home() / ".aos" / "users" / ".active-uid"
_UID      = _uid_file.read_text().strip() if _uid_file.exists() else None
_AOS      = (Path.home() / ".aos" / "users" / _UID / "fitness") if _UID else None

def sessions_dir() -> Path:
    if _AOS and (_AOS / "sessions").exists():
        return _AOS / "sessions"
    return _REPO / "data" / "sessions"

def sqlite_db() -> Path:
    return sessions_dir() / "training_history.sqlite"

# ── Domain ────────────────────────────────────────────────────────────────────
ACTIVITY_EMOJI = {
    "running": "🏃", "cycling": "🚴", "swimming": "🏊", "hiking": "🥾",
    "rowing": "🚣", "climbing": "🧗", "yoga": "🧘", "stretching": "🤸",
    "hiit": "⚡", "walking": "🚶",
}
ACTIVITY_LABEL = {
    "running": "Laufen", "cycling": "Radfahren", "swimming": "Schwimmen",
    "hiking": "Wandern", "rowing": "Rudern", "climbing": "Klettern",
    "yoga": "Yoga", "stretching": "Stretching", "hiit": "HIIT", "walking": "Spazieren",
}
BLOCK_COLOR = {
    "push": "magenta", "pull": "green", "legs": "dark_orange",
    "upper": "cyan", "lower": "yellow", "full": "gold1",
}
WEEKDAYS_DE = ["Mo", "Di", "Mi", "Do", "Fr", "Sa", "So"]

def block_color(block: str) -> str:
    bl = (block or "").lower()
    for k, c in BLOCK_COLOR.items():
        if k in bl:
            return c
    return "bright_magenta"

def classify(s: dict) -> str:
    mode = s.get("sessionMode")
    act  = s.get("activity")
    exs  = [e for e in (s.get("exercises") or []) if e.get("done")]
    if mode == "cardio" or (act and not exs):
        return "cardio"
    if act and exs:
        return "strength+addon"
    return "strength"

def _parse_date(stem: str) -> str | None:
    if len(stem) >= 10 and stem[:10].count("-") == 2:
        return stem[:10]
    return None

# ── Data ──────────────────────────────────────────────────────────────────────
def load_sessions(days: int = 60) -> list[dict]:
    sdir   = sessions_dir()
    cutoff = (date.today() - timedelta(days=days)).isoformat()
    out    = []
    for f in sorted(sdir.glob("*.json"), reverse=True):
        d = _parse_date(f.stem)
        if not d or d < cutoff:
            continue
        try:
            s = json.loads(f.read_text())
            s.setdefault("date", d)
            s["_stem"] = f.stem
            out.append(s)
        except Exception:
            pass
    out.sort(key=lambda s: (s["date"], s.get("_stem", "")), reverse=True)
    return out

def sync_info() -> dict:
    r = subprocess.run(
        ["systemctl", "--user", "show",
         "fitness-firestore-mirror.service",
         "--property=ActiveState,SubState,ExecMainStartTimestamp"],
        capture_output=True, text=True)
    props = dict(line.split("=", 1) for line in r.stdout.strip().splitlines() if "=" in line)
    daemon = subprocess.run(["pgrep", "-fa", "mirror.py"],
                            capture_output=True, text=True).stdout.strip()
    sdir = sessions_dir()
    json_count = len(list(sdir.glob("*.json")))
    db = sqlite_db()
    sqlite_n, sqlite_latest = 0, "?"
    if db.exists():
        try:
            con = sqlite3.connect(str(db))
            sqlite_n      = con.execute("SELECT COUNT(*) FROM training_history").fetchone()[0]
            sqlite_latest = con.execute("SELECT MAX(date) FROM training_history").fetchone()[0] or "?"
            con.close()
        except Exception:
            pass
    newest = max(
        (_parse_date(f.stem) or "" for f in sdir.glob("*.json")),
        default="?")
    return {
        "state": props.get("ActiveState", "?"),
        "sub":   props.get("SubState", "?"),
        "last":  props.get("ExecMainStartTimestamp", "?"),
        "daemon": bool(daemon),
        "json_count": json_count,
        "sqlite_n": sqlite_n,
        "sqlite_latest": sqlite_latest,
        "newest": newest,
        "newest_age": (date.today() - date.fromisoformat(newest)).days
            if newest and newest != "?" else "?",
        "sdir": str(sdir),
    }

# ── Client data ───────────────────────────────────────────────────────────────
_USERS_ROOT = Path.home() / ".aos" / "users"
_SKIP_DIRS  = {"default", "kb"}   # non-user dirs

def _uid_alias(uid: str) -> str:
    """Short readable alias: first 6 chars of UID."""
    return uid[:6] + "…"

def load_all_clients(days: int = 10) -> list[dict]:
    """
    Scan all ~/.aos/users/<uid>/fitness/sessions/ directories.
    Returns a list of client dicts, each with:
      uid, alias, sessions (list, newest first), last_date, session_count
    Excludes the active UID (that's the coach / own log).
    """
    if not _USERS_ROOT.exists():
        return []
    cutoff = (date.today() - timedelta(days=days)).isoformat()
    clients = []
    for user_dir in sorted(_USERS_ROOT.iterdir()):
        uid = user_dir.name
        if uid in _SKIP_DIRS or uid.startswith("."):
            continue
        sdir = user_dir / "fitness" / "sessions"
        if not sdir.exists():
            continue
        sessions = []
        for f in sorted(sdir.glob("*.json"), reverse=True):
            d = _parse_date(f.stem)
            if not d:
                continue
            try:
                s = json.loads(f.read_text())
                s.setdefault("date", d)
                s["_uid"]  = uid
                s["_stem"] = f.stem
                if d >= cutoff:
                    sessions.append(s)
            except Exception:
                pass
        # also grab last_date from all-time (even if outside window)
        all_dates = sorted(
            (d for f in sdir.glob("*.json") if (d := _parse_date(f.stem))),
            reverse=True)
        last_date    = all_dates[0] if all_dates else "—"
        total_count  = len(all_dates)
        sessions.sort(key=lambda s: (s["date"], s.get("_stem","")), reverse=True)
        clients.append({
            "uid":           uid,
            "alias":         _uid_alias(uid),
            "is_self":       uid == _UID,
            "sessions":      sessions,   # last 10 days only
            "last_date":     last_date,
            "total_count":   total_count,
        })
    # Sort: most recent activity first
    clients.sort(key=lambda c: c["last_date"], reverse=True)
    return clients

# ── Detail Modal ──────────────────────────────────────────────────────────────
class DetailModal(ModalScreen):
    BINDINGS = [Binding("escape,enter,q", "dismiss", "Schließen")]
    CSS = """
    DetailModal {
        align: center middle;
    }
    DetailModal > Container {
        width: 80;
        max-height: 90%;
        background: $surface;
        border: round $primary;
        padding: 1 2;
    }
    .detail-title { color: $primary; text-style: bold; margin-bottom: 1; }
    .detail-meta  { color: $text-muted; margin-bottom: 1; }
    .detail-ex    { color: $text; margin-left: 2; }
    .detail-ex-sets { color: $primary-lighten-2; margin-left: 4; }
    .detail-finisher { color: $warning; margin-top: 1; }
    .detail-note  { color: $text-muted; font-style: italic; margin-top: 1; }
    .detail-close { color: $text-muted; margin-top: 1; text-align: right; }
    """

    def __init__(self, session: dict) -> None:
        super().__init__()
        self.session = session

    def compose(self) -> ComposeResult:
        s     = self.session
        kind  = classify(s)
        act   = s.get("activity") or {}
        exs   = [e for e in (s.get("exercises") or []) if e.get("done")]
        block = s.get("block", "")
        eff   = s.get("effort")
        dur   = s.get("duration")
        loc   = s.get("location", "")
        notes = s.get("notes", "")
        d     = s.get("date", "?")
        try:
            dt_s = datetime.strptime(d, "%Y-%m-%d").strftime("%A, %d. %B %Y")
        except Exception:
            dt_s = d

        lines = []
        if kind == "cardio":
            atype = act.get("type", "?")
            emoji = ACTIVITY_EMOJI.get(atype, "🏃")
            label = ACTIVITY_LABEL.get(atype, atype)
            adur  = act.get("duration", "")
            lines.append(("detail-title", f"{emoji}  {label}  —  {dt_s}"))
            if adur:
                lines.append(("detail-meta", f"⏱  {adur} Minuten"))
        else:
            color = block_color(block)
            lines.append(("detail-title", f"💪  {block or '?'}  —  {dt_s}"))
            meta = []
            if eff:  meta.append(f"RPE {eff}/10")
            if dur:  meta.append(f"{dur} min")
            if loc:  meta.append(f"📍 {loc}")
            if meta: lines.append(("detail-meta", "  ·  ".join(meta)))
            if kind == "strength+addon":
                atype = act.get("type", "?")
                adur  = act.get("duration", "")
                emoji = ACTIVITY_EMOJI.get(atype, "⚡")
                label = ACTIVITY_LABEL.get(atype, atype)
                lines.append(("detail-finisher",
                    f"⚡ Finisher: {emoji} {label}" + (f" · {adur}min" if adur else "")))
            if exs:
                lines.append(("detail-meta", f"\n{'─'*40}\n{len(exs)} Exercises:\n"))
                for ex in exs:
                    name = ex.get("name", "?")
                    pm   = ", ".join(ex.get("primaryMuscles") or [])
                    note = ex.get("note", "")
                    lines.append(("detail-ex", f"▸ {name}  [{pm}]" if pm else f"▸ {name}"))
                    sets_arr = ex.get("setsArray") or []
                    for i, st in enumerate(sets_arr, 1):
                        r = st.get("reps", ""); w = st.get("weight", "")
                        parts = [f"{r} Wdh" if r else None, f"{w} kg" if w else None]
                        parts = [p for p in parts if p]
                        if parts:
                            lines.append(("detail-ex-sets", f"  Set {i}: {'  ·  '.join(parts)}"))
                    if note:
                        lines.append(("detail-ex-sets", f"  ↳ {note}"))
        if notes:
            lines.append(("detail-note", f"\n{notes}"))
        lines.append(("detail-close", "\n[Esc / Enter zum Schließen]"))

        with Container():
            for cls, text in lines:
                yield Label(text, classes=cls)

# ── Log Tab ───────────────────────────────────────────────────────────────────
class SessionTable(Widget):
    BINDINGS: ClassVar = [
        Binding("enter", "select", "Detail"),
        Binding("r",     "reload", "Reload"),
    ]
    CSS = """
    SessionTable {
        height: 1fr;
    }
    SessionTable DataTable {
        height: 1fr;
    }
    .filter-bar {
        height: 3;
        background: $surface;
        padding: 0 1;
        border-bottom: solid $primary;
    }
    """
    sessions: reactive[list[dict]] = reactive([], recompose=True)
    filter_text: reactive[str]     = reactive("")

    def __init__(self, sessions: list[dict]) -> None:
        super().__init__()
        self.sessions = sessions

    def compose(self) -> ComposeResult:
        table = DataTable(zebra_stripes=True, cursor_type="row")
        table.add_columns("Datum", "Typ", "Block / Aktivität", "Details", "Effort")
        for s in self._filtered():
            self._add_row(table, s)
        yield table

    def _filtered(self) -> list[dict]:
        q = self.filter_text.lower()
        if not q:
            return self.sessions
        return [s for s in self.sessions
                if q in (s.get("block") or "").lower()
                or q in (s.get("notes") or "").lower()
                or q in ((s.get("activity") or {}).get("type") or "").lower()]

    @staticmethod
    def _add_row(table: DataTable, s: dict) -> None:
        d     = s.get("date", "?")
        kind  = classify(s)
        act   = s.get("activity") or {}
        exs   = [e for e in (s.get("exercises") or []) if e.get("done")]
        block = s.get("block", "")
        eff   = s.get("effort")

        today = date.today().isoformat()
        yest  = (date.today() - timedelta(days=1)).isoformat()
        if d == today:
            date_cell = f"[bold bright_magenta]Heute[/]"
        elif d == yest:
            date_cell = f"[dim]Gestern[/]"
        else:
            try:
                date_cell = datetime.strptime(d, "%Y-%m-%d").strftime("%a %d.%m")
            except Exception:
                date_cell = d

        if kind == "cardio":
            atype = act.get("type", "?")
            adur  = act.get("duration", "")
            emoji = ACTIVITY_EMOJI.get(atype, "🏃")
            label = ACTIVITY_LABEL.get(atype, atype)
            table.add_row(date_cell, emoji, f"[dark_orange]{label}[/]",
                          f"[dim]{adur}min[/]" if adur else "—", "—",
                          key=s.get("_stem", d))
        else:
            color = block_color(block)
            names = ", ".join(e.get("name", "?") for e in exs[:3])
            ellipsis = "…" if len(exs) > 3 else ""
            addon = ""
            if kind == "strength+addon":
                atype = act.get("type", "?")
                adur  = act.get("duration", "")
                emoji = ACTIVITY_EMOJI.get(atype, "⚡")
                addon = f"  [dark_orange]{emoji}{'+'+str(adur)+'min' if adur else ''}[/]"
            eff_cell  = f"[yellow]{eff}/10[/]" if eff else "—"
            table.add_row(
                date_cell, "💪",
                f"[{color}]{block or '?'}[/]",
                f"[dim]{names}{ellipsis}[/]{addon}",
                eff_cell,
                key=s.get("_stem", d),
            )

    def action_select(self) -> None:
        table = self.query_one(DataTable)
        if table.cursor_row is None:
            return
        filtered = self._filtered()
        if 0 <= table.cursor_row < len(filtered):
            self.app.push_screen(DetailModal(filtered[table.cursor_row]))

    def action_reload(self) -> None:
        self.app.reload_data()

    def watch_filter_text(self) -> None:
        self.recompose()

    def watch_sessions(self) -> None:
        self.recompose()

# ── Woche Tab ─────────────────────────────────────────────────────────────────
class WeekView(Static):
    DEFAULT_CSS = """
    WeekView {
        padding: 1 2;
        height: auto;
    }
    """

    def __init__(self, sessions: list[dict]) -> None:
        super().__init__()
        self.sessions = sessions

    def render(self) -> str:
        today = date.today()
        by_date: dict[str, list[dict]] = {}
        for s in self.sessions:
            by_date.setdefault(s["date"], []).append(s)

        lines = []
        for i in range(6, -1, -1):
            d   = (today - timedelta(days=i)).isoformat()
            wd  = WEEKDAYS_DE[(today - timedelta(days=i)).weekday()]
            day_s = by_date.get(d, [])
            is_today = d == today.isoformat()
            prefix = f"[bold bright_magenta]{wd} {d}[/]" if is_today else f"[dim]{wd} {d}[/]"
            if not day_s:
                lines.append(f"  {prefix}  [dim]·  Ruhetag[/]")
                continue
            parts = []
            for s in day_s:
                kind = classify(s)
                act  = s.get("activity") or {}
                exs  = [e for e in (s.get("exercises") or []) if e.get("done")]
                if kind == "cardio":
                    atype = act.get("type", "?")
                    adur  = act.get("duration", "")
                    emoji = ACTIVITY_EMOJI.get(atype, "🏃")
                    label = ACTIVITY_LABEL.get(atype, atype)
                    parts.append(f"{emoji} [dark_orange]{label}[/]" +
                                 (f" [dim]{adur}min[/]" if adur else ""))
                else:
                    block = s.get("block", "?")
                    color = block_color(block)
                    names = ", ".join(e.get("name", "?") for e in exs[:3])
                    addon = ""
                    if kind == "strength+addon":
                        atype = act.get("type", "?")
                        emoji = ACTIVITY_EMOJI.get(atype, "⚡")
                        addon = f"  [{emoji}]"
                    parts.append(f"[{color}]●[/] [{color}]{block}[/]  [dim]{names}[/]{addon}")
            lines.append(f"  {prefix}  " + "  [dim]│[/]  ".join(parts))
        return "\n".join(lines)

# ── Stats Tab ─────────────────────────────────────────────────────────────────
class StatsView(Static):
    DEFAULT_CSS = "StatsView { padding: 1 2; height: auto; }"

    def __init__(self, sessions: list[dict]) -> None:
        super().__init__()
        self.sessions = sessions

    def render(self) -> str:
        strength = [s for s in self.sessions if classify(s) != "cardio"]
        cardio   = [s for s in self.sessions if classify(s) == "cardio"]
        total_ex = sum(len([e for e in (s.get("exercises") or []) if e.get("done")]) for s in strength)
        cardio_min = 0
        for s in cardio:
            try: cardio_min += int((s.get("activity") or {}).get("duration") or 0)
            except: pass

        block_dist: dict[str, int] = {}
        muscle_freq: dict[str, int] = {}
        for s in strength:
            bl = (s.get("block") or "?").strip()
            block_dist[bl] = block_dist.get(bl, 0) + 1
            for ex in (s.get("exercises") or []):
                if ex.get("done"):
                    for m in (ex.get("primaryMuscles") or []):
                        muscle_freq[m] = muscle_freq.get(m, 0) + 1

        cardio_dist: dict[str, int] = {}
        for s in cardio:
            atype = (s.get("activity") or {}).get("type", "?")
            cardio_dist[atype] = cardio_dist.get(atype, 0) + 1

        out = ["[bold]Sessions[/bold]"]
        out.append(f"  Kraft:    [bright_magenta]{len(strength)}x[/]  ·  [dim]{total_ex} Übungen gesamt[/]")
        out.append(f"  Ausdauer: [dark_orange]{len(cardio)}x[/]" +
                   (f"  ·  [dim]{cardio_min} min[/]" if cardio_min else ""))

        if block_dist:
            out.append("\n[bold]Training-Split[/bold]")
            max_cnt = max(block_dist.values()) if block_dist else 1
            for bl, cnt in sorted(block_dist.items(), key=lambda x: -x[1]):
                color = block_color(bl)
                bar   = "█" * cnt + "░" * max(0, max_cnt - cnt)
                out.append(f"  [{color}]{bl:<14}[/]  [{color}]{bar}[/]  [dim]{cnt}x[/]")

        if cardio_dist:
            out.append("\n[bold]Ausdauer[/bold]")
            for atype, cnt in sorted(cardio_dist.items(), key=lambda x: -x[1]):
                emoji = ACTIVITY_EMOJI.get(atype, "🏃")
                label = ACTIVITY_LABEL.get(atype, atype)
                out.append(f"  {emoji} [dark_orange]{label:<14}[/] [dim]{cnt}x[/]")

        if muscle_freq:
            out.append("\n[bold]Muskel-Coverage[/bold]")
            max_m = max(muscle_freq.values()) if muscle_freq else 1
            for m, cnt in sorted(muscle_freq.items(), key=lambda x: -x[1])[:8]:
                bar = "█" * min(cnt, 10) + "░" * max(0, 10 - cnt)
                out.append(f"  [white]{m:<14}[/]  [bright_magenta]{bar}[/]  [dim]{cnt}x[/]")

        return "\n".join(out)

# ── Sync Tab ──────────────────────────────────────────────────────────────────
class SyncView(Static):
    DEFAULT_CSS = "SyncView { padding: 1 2; height: auto; }"

    def __init__(self, info: dict) -> None:
        super().__init__()
        self.info = info

    def render(self) -> str:
        i = self.info
        state_color = "green" if i["state"] == "active" else "red"
        daemon_s    = "[green]● aktiv[/]" if i["daemon"] else "[yellow]○ inaktiv (boot-only)[/]"
        age         = i["newest_age"]
        age_color   = "green" if isinstance(age, int) and age < 2 else \
                      "yellow" if isinstance(age, int) and age < 7 else "red"
        last = i["last"][:19] if len(i["last"]) > 10 else i["last"]
        return "\n".join([
            "[bold]Firestore ↔ Lokal[/bold]\n",
            f"  [dim]Service:[/]       [{state_color}]{i['state']} ({i['sub']})[/]",
            f"  [dim]Letzter Run:[/]   [white]{last}[/]",
            f"  [dim]Mirror-Daemon:[/] {daemon_s}",
            "",
            f"  [dim]Pfad:[/]          [white]{i['sdir']}[/]",
            f"  [dim]JSON-Sessions:[/] [bright_magenta]{i['json_count']}[/]",
            f"  [dim]SQLite-Sets:[/]   [dim]{i['sqlite_n']}  (latest: {i['sqlite_latest']})[/]",
            f"  [dim]Neueste:[/]       [{age_color}]{i['newest']}[/]  [dim]({age} Tage alt)[/]",
            "",
            "  [dim]→ fitness sync   zum manuellen Pull/Push[/]",
        ])

# ── Clients Tab ───────────────────────────────────────────────────────────────
class ClientsView(Static):
    DEFAULT_CSS = """
    ClientsView {
        padding: 1 2;
        height: auto;
    }
    """

    def __init__(self, clients: list[dict], days: int = 10) -> None:
        super().__init__()
        self.clients = clients
        self.days    = days

    def render(self) -> str:
        if not self.clients:
            return "[dim]  Keine Klienten gefunden.[/]"

        today  = date.today()
        cutoff = (today - timedelta(days=self.days)).isoformat()

        # Build day-columns header
        day_cols = [(today - timedelta(days=i)).isoformat() for i in range(self.days - 1, -1, -1)]
        day_labels = " ".join(
            f"[bold bright_magenta]{(today-timedelta(days=i)).strftime('%d')}[/]"
            if (today-timedelta(days=i)).isoformat() == today.isoformat()
            else f"[dim]{(today-timedelta(days=i)).strftime('%d')}[/]"
            for i in range(self.days - 1, -1, -1)
        )

        lines: list[str] = []
        lines.append(f"[bold]Klienten-Logs — letzte {self.days} Tage[/bold]\n")
        # header row
        wd_labels = " ".join(
            f"{'[dim]':1}{(today-timedelta(days=i)).strftime('%a')[0:2]:2}[/]"
            for i in range(self.days - 1, -1, -1)
        )
        lines.append(f"  {'Klient':<10}  {wd_labels}  {'Letztes':<12} {'Total':>5}")
        lines.append(f"  {'─'*10}  {'── '*self.days} {'─'*12} {'─'*5}")

        for cl in self.clients:
            uid      = cl["uid"]
            alias    = cl["alias"]
            is_self  = cl["is_self"]
            sessions_map: dict[str, list[dict]] = {}
            for s in cl["sessions"]:
                sessions_map.setdefault(s["date"], []).append(s)

            # Streak dots per day
            dots = []
            for d in day_cols:
                day_sessions = sessions_map.get(d, [])
                if not day_sessions:
                    dots.append("[dim]·[/] ")
                    continue
                kinds = [classify(s) for s in day_sessions]
                has_strength = any(k != "cardio" for k in kinds)
                has_cardio   = any(k == "cardio"  for k in kinds)
                if has_strength and has_cardio:
                    dots.append("[bold magenta]◈[/] ")
                elif has_cardio:
                    dots.append("[dark_orange]●[/] ")
                else:
                    # color by block
                    block  = next((s.get("block","") for s in day_sessions if classify(s)!="cardio"), "")
                    color  = block_color(block)
                    dots.append(f"[{color}]●[/] ")

            streak_row = " ".join(d.strip() for d in dots)

            last   = cl["last_date"]
            total  = cl["total_count"]
            marker = " [dim](ich)[/]" if is_self else ""
            name_s = f"[bold]{alias}[/]{marker}" if is_self else f"[white]{alias}[/]"

            # Last-date age color
            try:
                age = (today - date.fromisoformat(last)).days
                last_c = "green" if age < 3 else "yellow" if age < 7 else "dim red"
                last_s = f"[{last_c}]{last}[/]"
            except Exception:
                last_s = f"[dim]{last}[/]"

            lines.append(f"  {name_s:<18}  {streak_row}  {last_s}  [dim]{total:>3}x[/]")

            # Expand sessions of last 10 days inline (compact)
            for d in day_cols:
                day_s = sessions_map.get(d, [])
                for s in day_s:
                    kind  = classify(s)
                    act   = s.get("activity") or {}
                    exs   = [e for e in (s.get("exercises") or []) if e.get("done")]
                    block = s.get("block", "")
                    eff   = s.get("effort")
                    d_label = datetime.strptime(d, "%Y-%m-%d").strftime("%d.%m")

                    if kind == "cardio":
                        atype = act.get("type", "?")
                        adur  = act.get("duration", "")
                        emoji = ACTIVITY_EMOJI.get(atype, "🏃")
                        label = ACTIVITY_LABEL.get(atype, atype)
                        lines.append(
                            f"    [dim]{d_label}[/]  {emoji} [dark_orange]{label}[/]"
                            + (f" [dim]{adur}min[/]" if adur else ""))
                    else:
                        color = block_color(block)
                        names = ", ".join(e.get("name","?") for e in exs[:3])
                        addon = ""
                        if kind == "strength+addon":
                            atype = act.get("type", "?")
                            addon = f"  [dark_orange]{ACTIVITY_EMOJI.get(atype,'⚡')}[/]"
                        eff_s = f" [dim]RPE {eff}[/]" if eff else ""
                        lines.append(
                            f"    [dim]{d_label}[/]  [{color}]{block or '?'}[/]"
                            + (f"  [dim]{names}[/]" if names else "")
                            + eff_s + addon)
            lines.append("")

        return "\n".join(lines)

# ── Main App ──────────────────────────────────────────────────────────────────
class FitnessTUI(App):
    TITLE    = "AlphaOS Fitness"
    SUB_TITLE = "Session Dashboard"
    CSS_PATH  = None
    CSS = """
    Screen {
        background: $background;
    }
    TabbedContent {
        height: 1fr;
    }
    TabPane {
        padding: 0;
        height: 1fr;
    }
    SessionTable {
        height: 1fr;
    }
    #filter-input {
        height: 3;
        border: solid $primary;
        margin: 0 1 1 1;
        display: none;
    }
    #filter-input.visible {
        display: block;
    }
    ScrollableContainer {
        height: 1fr;
    }
    """
    BINDINGS: ClassVar = [
        Binding("1", "show_tab('log')",     "Log",     show=True),
        Binding("2", "show_tab('woche')",   "Woche",   show=True),
        Binding("3", "show_tab('stats')",   "Stats",   show=True),
        Binding("4", "show_tab('sync')",    "Sync",    show=True),
        Binding("5", "show_tab('clients')", "Clients", show=True),
        Binding("r", "reload",              "Reload"),
        Binding("q", "quit",               "Quit"),
    ]

    sessions: reactive[list[dict]] = reactive([], recompose=True)
    sync:     reactive[dict]       = reactive({})
    clients:  reactive[list[dict]] = reactive([])

    def compose(self) -> ComposeResult:
        yield Header(show_clock=True)
        with TabbedContent(initial="log"):
            with TabPane("📋 Log", id="log"):
                yield SessionTable(self.sessions)
            with TabPane("📅 Woche", id="woche"):
                with ScrollableContainer():
                    yield WeekView(self.sessions)
            with TabPane("📊 Stats", id="stats"):
                with ScrollableContainer():
                    yield StatsView(self.sessions)
            with TabPane("🔄 Sync", id="sync"):
                with ScrollableContainer():
                    yield SyncView(self.sync)
            with TabPane("👥 Clients", id="clients"):
                with ScrollableContainer():
                    yield ClientsView(self.clients)
        yield Footer()

    def on_mount(self) -> None:
        self.reload_data()

    @work(thread=True)
    def reload_data(self) -> None:
        sessions = load_sessions(60)
        info     = sync_info()
        clients  = load_all_clients(10)
        self.call_from_thread(self._apply_data, sessions, info, clients)

    def _apply_data(self, sessions: list[dict], info: dict, clients: list[dict]) -> None:
        self.sessions = sessions
        self.sync     = info
        self.clients  = clients
        try:
            self.query_one(SessionTable).sessions = sessions
            self.query_one(WeekView).sessions     = sessions
            self.query_one(WeekView).refresh()
            self.query_one(StatsView).sessions    = sessions
            self.query_one(StatsView).refresh()
            self.query_one(SyncView).info         = info
            self.query_one(SyncView).refresh()
            self.query_one(ClientsView).clients   = clients
            self.query_one(ClientsView).refresh()
        except Exception:
            pass

    def action_show_tab(self, tab_id: str) -> None:
        self.query_one(TabbedContent).active = tab_id

    def action_reload(self) -> None:
        self.notify("Daten werden neu geladen…", severity="information", timeout=2)
        self.reload_data()


if __name__ == "__main__":
    FitnessTUI().run()
