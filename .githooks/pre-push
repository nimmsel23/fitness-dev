#!/bin/bash
# pre-push hook: build + deploy to Firebase when relevant frontend files are
# part of the push to master (sw-cache-bump + manifest-version-bump happen
# inside `npm run build:firebase` via scripts/bump-sw.mjs). Also pushes
# changed catalog/KB YAMLs (fitness/catalog/kb/) to Firestore via
# `fitness-catalog push-changed` — scoped to the pushed range, no
# FITNESS_ENV=prod-Gate noetig (im Unterschied zu `fitness-catalog push`).
#
# Runs once per push (not per ref), reads pushed refs from stdin.
#
# 2026-08-14: wiederhergestellt, nachdem ein Auto-Commit (bb4d9b8) die Datei
# versehentlich geloescht hatte (README.md dokumentierte sie weiterhin, nur
# die Datei selbst fehlte — Deploy lief seither nur noch ueber den GH-Actions-
# Workflow, nicht mehr lokal). KB-Push-Block ist neu dazugekommen.

cd "$(git rev-parse --show-toplevel)"

# public/sw.js + public/manifest.json + dist-firebase/ sind Build-Output des
# vorherigen Laufs (bump-sw.mjs, vite build) — nie selbst ein Deploy-Grund,
# sonst triggert der Hook sich bei jedem Push auf sich selbst (endlose
# Bump-Spirale ohne echten Inhalt).
SKIP='^cloud_chamber/|\.(md|txt|bak|bak2)$|^public/sw\.js$|^public/manifest\.json$|^dist-firebase/'
TRIGGER='^(src/|public/|index.html$|vite.config.(js|ts|mjs)$|package.json$|firebase.json$|firestore.rules$|firestore.indexes.json$)'
KB_TRIGGER='^fitness/catalog/kb/'

should_deploy=false
kb_since=""
kb_until=""

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  branch="${local_ref#refs/heads/}"
  [ "$branch" != "master" ] && continue

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    # New branch on remote — diff against empty tree
    range="$local_sha"
    changed=$(git diff-tree --no-commit-id --name-only -r "$range")
    kb_since=$(git hash-object -t tree /dev/null)
  else
    changed=$(git diff --name-only "$remote_sha" "$local_sha")
    kb_since="$remote_sha"
  fi
  kb_until="$local_sha"

  relevant=$(echo "$changed" | grep -Ev "$SKIP" || true)
  if echo "$relevant" | grep -Eq "$TRIGGER"; then
    should_deploy=true
  fi

  if echo "$changed" | grep -Eq "$KB_TRIGGER"; then
    if command -v gum >/dev/null 2>&1; then
      gum log --level info "fitness-dev: KB-Aenderungen im Push zu master — pushe geaenderte Exercises/Muskeln zu Firestore…"
    else
      echo "🔍 fitness-dev: KB-Aenderungen im Push zu master — pushe geaenderte Exercises/Muskeln zu Firestore…"
    fi
    if command -v fitness-catalog >/dev/null 2>&1; then
      fitness-catalog push-changed --since "$kb_since" --until "$kb_until"
      kb_status=$?
      if [ $kb_status -ne 0 ]; then
        echo "⚠️  fitness-catalog push-changed fehlgeschlagen — Push wird NICHT abgebrochen (Firestore-Sync ist nachholbar, Frontend-Deploy nicht blockieren)." >&2
      fi
    else
      echo "⚠️  fitness-catalog nicht gefunden (uv tool) — KB-Push uebersprungen, manuell nachholen: fitness-catalog push-changed --since $kb_since --until $kb_until" >&2
    fi
  fi
done

if [ "$should_deploy" != true ]; then
  exit 0
fi

if command -v gum >/dev/null 2>&1; then
  gum log --level info "fitness-dev: relevante Änderungen im Push zu master — baue + deploye zu Firebase…"
else
  echo "🔍 fitness-dev: relevante Änderungen im Push zu master — baue + deploye zu Firebase…"
fi

npm run firebase
status=$?

if [ $status -ne 0 ]; then
  echo "❌ npm run firebase fehlgeschlagen — Push wird abgebrochen (kein halb-deployter Stand)." >&2
  echo "   Mit 'git push --no-verify' kannst du den Hook überspringen, falls das Absicht ist." >&2
  exit 1
fi

echo "✅ Deploy abgeschlossen. sw.js/manifest.json wurden ggf. gebumpt — nicht vergessen zu committen."
exit 0
