#!/bin/bash
# pre-push: Build-Verifikation + Staging auf `dev`; Prod/Shell laufen per CI + vos-release.
# Standalone-Live und Shell-Pin sind kein lokaler Hook-Pfad mehr (kein Branch `vitalos`).
#
# Runs once per push (not per ref), reads pushed refs from stdin.

cd "$(git rev-parse --show-toplevel)"

SKIP='^cloud_chamber/|(^|/)(AGENTS\.md|README([^/]*)?\.md)$|(^|/)docs/|\.(md|mdx|markdown|txt|bak|bak2)$|^public/sw\.js$|^public/manifest\.json$|^dist-firebase/'
TRIGGER='^(src/|public/|index.html$|vite.config.(js|ts|mjs)$|package.json$|firebase.json$|mini-app.json$|scripts/mini-app-shell/|firestore.rules$|firestore.indexes.json$)'
KB_TRIGGER='^fitness/catalog/kb/'
BACKEND_TRIGGER='^(fitness/|db/|alembic/|server\.mjs$|fitness-runtime\.mjs$|firestore-mirror\.mjs$)'

ship_sha=""
should_deploy_staging=false
should_build_dev=false
kb_since=""
kb_until=""
should_push_kb=false

while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$local_ref" ] && continue
  branch="${local_ref#refs/heads/}"

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    range="$local_sha"
    changed=$(git diff-tree --no-commit-id --name-only -r "$range")
    kb_since=$(git hash-object -t tree /dev/null)
  else
    changed=$(git diff --name-only "$remote_sha" "$local_sha")
    kb_since="$remote_sha"
  fi
  kb_until="$local_sha"

  if [ "$branch" = "dev" ] && [ "$local_sha" != "0000000000000000000000000000000000000000" ] \
     && { [ "${VOS_SHIP:-}" = "1" ] || git log -1 --format=%s "$local_sha" | grep -qF '[ship]'; }; then
    ship_sha="$local_sha"
  fi

  relevant=$(echo "$changed" | grep -Ev "$SKIP" || true)

  if [ "$branch" = "dev" ] && [ -n "$relevant" ]; then
    echo "💡 Release: dev → master (Auto-Promote / vos-release-pr fitness); Shell-Pin mit fitness-release / vos-ship. Doku: ~/vitalos/docs/DEPLOYMENT.md" >&2
  fi

  if [ "$branch" = "dev" ] && echo "$changed" | grep -Ev "$SKIP" | grep -Eq "$BACKEND_TRIGGER"; then
    should_deploy_staging=true
  fi

  if [ "$branch" = "dev" ] && echo "$relevant" | grep -Eq "$TRIGGER"; then
    should_build_dev=true
  fi

  # KB-Sync beim Push auf dev (früher: Branch vitalos)
  if [ "$branch" = "dev" ] && echo "$changed" | grep -Eq "$KB_TRIGGER"; then
    should_push_kb=true
  fi
done

if [ "$should_push_kb" = true ]; then
  if command -v gum >/dev/null 2>&1; then
    gum log --level info "fitness-dev: KB-Aenderungen im Push zu dev — pushe geaenderte Exercises/Muskeln zu Firestore…"
  else
    echo "🔍 fitness-dev: KB-Aenderungen im Push zu dev — pushe geaenderte Exercises/Muskeln zu Firestore…"
  fi
  if command -v fitness-catalog >/dev/null 2>&1; then
    fitness-catalog push-changed --since "$kb_since" --until "$kb_until" || \
      echo "⚠️  fitness-catalog push-changed fehlgeschlagen — Push wird NICHT abgebrochen." >&2
  else
    echo "⚠️  fitness-catalog nicht gefunden — KB-Push uebersprungen." >&2
  fi
fi

if [ -n "$ship_sha" ]; then
  echo "🚢 [ship]: Release startet nach dem Push im Hintergrund (Log: ~/.cache/vos-ship/, Ergebnis per Desktop-Meldung)." >&2
  nohup setsid ./scripts/ship-after-push.sh "$PPID" "$ship_sha" >/dev/null 2>&1 &
fi

if [ "$should_build_dev" = true ]; then
  if command -v gum >/dev/null 2>&1; then
    gum log --level info "fitness-dev: Push zu dev — baue UI (pnpm run build) als Build-Verifikation…"
  else
    echo "🔍 fitness-dev: Push zu dev — baue UI (pnpm run build) als Build-Verifikation…"
  fi
  pnpm run build
  build_status=$?
  if [ $build_status -ne 0 ]; then
    echo "❌ pnpm run build fehlgeschlagen — Push wird abgebrochen." >&2
    echo "   Mit 'git push --no-verify' kannst du den Hook überspringen." >&2
    exit 1
  fi
  echo "✅ Build-Verifikation OK (dist/ aktuell)."
fi

if [ "$should_deploy_staging" = true ]; then
  if command -v gum >/dev/null 2>&1; then
    gum log --level info "fitness-dev: Backend-Aenderungen im Push zu dev — deploye nach staging (:8100)…"
  else
    echo "🔍 fitness-dev: Backend-Aenderungen im Push zu dev — deploye nach staging (:8100)…"
  fi
  if [ -x ./deploy.sh ]; then
    ./deploy.sh staging || echo "⚠️  ./deploy.sh staging fehlgeschlagen — Push wird NICHT abgebrochen." >&2
  else
    echo "⚠️  deploy.sh nicht ausfuehrbar — Staging-Deploy uebersprungen." >&2
  fi
fi

exit 0
