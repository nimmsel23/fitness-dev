{
  "name": "journal-dev",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node server.mjs & npx vite --port 9171",
    "server": "node server.mjs",
    "ui": "npx vite --port 9171",
    "build": "npx vite build",
