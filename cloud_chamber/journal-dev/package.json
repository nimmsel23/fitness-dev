    "deploy": "npm run build:firebase && firebase deploy --only hosting",
    "start": "node server.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "firebase": "^11.10.0",
    "hono": "^4.12.19",
