#!/usr/bin/env python3
"""
fitnessctl — Fitness Centre Unified CLI (typer, autocompletion-ready)

Server commands (delegated from fitness-devctl):
  status, start, stop, restart, enable, disable, health, logs, dev, build, deploy

Domain commands:
  tui, watch, push, pull, catalog, session, journal, coverage, gaps, search
"""

import importlib.util
import json
import os
import subprocess
import sys
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Optional

import typer
from wasabi import Printer

msg = Printer()

# ── Bootstrap ────────────────────────────────────────────────────────────────

DEV_DIR = Path(__file__).resolve().parent
CATALOG_DIR = DEV_DIR / "catalog"

# Ensure fitness_agent is importable
if str(CATALOG_DIR) not in sys.path:
    sys.path.insert(0, str(CATALOG_DIR))

NODE_PORT = os.getenv("FITNESS_NODE_PORT", "9100")
NODE_URL = f"http://127.0.0.1:{NODE_PORT}"

app = typer.Typer(help="Fitness Centre — Service Control + Domain CLI", no_args_is_help=True)

# ── Merge fitness-devctl commands ─────────────────────────────────────────────

def _load_devctl() -> Optional[object]:
    devctl_path = DEV_DIR / "fitness-devctl"
    if not devctl_path.exists():
        return None
    try:
        from importlib.machinery import SourceFileLoader
        loader = SourceFileLoader("fitness_devctl", str(devctl_path))
        mod = loader.load_module()
        return mod
    except Exception as e:
        msg.warn(f"Could not load fitness-devctl: {e}")
        return None

_devctl = _load_devctl()
if _devctl and hasattr(_devctl, "app"):
    for cmd_info in _devctl.app.registered_commands:
        app.registered_commands.append(cmd_info)

# ── Helpers ───────────────────────────────────────────────────────────────────

def _api_get(path: str) -> dict:
    url = f"{NODE_URL}{path}"
    try:
        with urllib.request.urlopen(url, timeout=5) as r:
            return json.loads(r.read())
    except Exception as e:
        msg.fail(f"API request failed ({url}): {e}")
        raise typer.Exit(1)

def _run(*cmd: str, cwd: Path = DEV_DIR, **kwargs) -> int:
    return subprocess.run(list(cmd), cwd=cwd, **kwargs).returncode

# ── Domain Commands ───────────────────────────────────────────────────────────

@app.command()
def tui(screen: str = typer.Argument("dashboard", help="Initial screen")):
    """Open fitness-agent TUI."""
    from fitness_agent.app_tui import run_tui
    run_tui(initial_screen=screen)


@app.command()
def watch():
    """Start AI Enricher Watcher (background)."""
    pidfile = Path("/tmp/fitness-enricher.pid")
    logfile = Path("/tmp/fitness-enricher.log")

    if pidfile.exists():
        try:
            pid = int(pidfile.read_text().strip())
            os.kill(pid, 0)
            msg.warn(f"Watcher already running (PID {pid})")
            return
        except (ProcessLookupError, ValueError):
            pidfile.unlink(missing_ok=True)

    import shlex
    proc = subprocess.Popen(
        [sys.executable, "-m", "fitness_agent", "watch"],
        cwd=DEV_DIR,
        env={**os.environ, "PYTHONPATH": str(CATALOG_DIR)},
        stdout=open(logfile, "a"),
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    pidfile.write_text(str(proc.pid))
    msg.good(f"Watcher started (PID {proc.pid}, log: {logfile})")


@app.command()
def push(dry_run: bool = typer.Option(False, "--dry-run")):
    """Push local catalog → Firestore."""
    args = [sys.executable, "-m", "fitness_agent", "push"]
    if dry_run:
        args.append("--dry-run")
    env = {**os.environ, "PYTHONPATH": str(CATALOG_DIR)}

    try:
        subprocess.run(
            ["gum", "spin", "--spinner", "dot",
             f"--title=Pushing catalog → Firestore{'  (dry-run)' if dry_run else ''}...",
             "--"] + args,
            cwd=DEV_DIR, env=env,
        )
    except FileNotFoundError:
        subprocess.run(args, cwd=DEV_DIR, env=env)


@app.command()
def pull(uid: Optional[str] = typer.Argument(None, help="Firestore user UID (auto-detected if omitted)")):
    """Pull sessions ← Firestore."""
    if not uid:
        uid = os.getenv("FITNESS_UID")
    if not uid:
        base = Path.home() / ".aos" / "fitness" / "users"
        best, best_n = None, -1
        for d in base.glob("*/sessions/"):
            name = d.parent.name
            if name in ("default", "kb"):
                continue
            n = len(list(d.glob("*.json")))
            if n > best_n:
                best, best_n = name, n
        uid = best
    if not uid:
        msg.fail("No uid found — set FITNESS_UID or pass as argument")
        raise typer.Exit(1)

    msg.info(f"Pulling sessions ← Firestore (uid={uid})...")
    out = Path("/tmp/fitness-pull.json")
    r = subprocess.run(
        ["curl", "-fsS", "--max-time", "30", "-X", "POST",
         f"{NODE_URL}/firestore/pull", "-H", f"X-User-UID: {uid}", "-o", str(out)],
    )
    if r.returncode != 0:
        msg.fail("Pull request failed")
        raise typer.Exit(1)
    result = json.loads(out.read_text())
    if not result.get("ok"):
        msg.fail(result.get("error", "unknown error"))
        raise typer.Exit(1)
    msg.good(f"pulled {result['pulled']} · skipped {result['skipped']} · conflicts {result['conflicts']}")
    if result.get("conflict_dates"):
        msg.warn(f"Conflicts (check manually): {', '.join(result['conflict_dates'])}")


