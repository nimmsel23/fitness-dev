#!/usr/bin/env bash
# fitnessctl — manage fitness-dev server (API :9002, UI :5902)
set -euo pipefail

ROOT="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
API_PORT="${FITNESS_API_PORT:-9002}"
UI_PORT="${FITNESS_UI_PORT:-5902}"
HOST="${FITNESS_HOST:-127.0.0.1}"
API_URL="http://${HOST}:${API_PORT}"

have_gum() { command -v gum >/dev/null 2>&1; }
msg()  { have_gum && gum log --level info  "$*" || printf '\033[1;32m  %s\033[0m\n' "$*"; }
warn() { have_gum && gum log --level warn  "$*" >&2 || printf '\033[1;33m  %s\033[0m\n' "$*" >&2; }
err()  { have_gum && gum log --level error "$*" >&2 || printf '\033[1;31m  %s\033[0m\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

usage() {
  cat <<EOF
fitnessctl — fitness-dev service control (API :${API_PORT}, UI :${UI_PORT})

  fitnessctl start        Start API server (background)
  fitnessctl stop         Stop API server
  fitnessctl restart      Restart API server
  fitnessctl status       Show running status
  fitnessctl health       Health check
  fitnessctl dev          Start API + Vite (foreground, both)
  fitnessctl build        npm run build (Vite → dist/)
  fitnessctl logs         Tail API server log

  fitnessctl session today          Show today's session
  fitnessctl session get DATE       Show session for DATE (YYYY-MM-DD)
  fitnessctl session list [N]       List last N sessions (default 10)

  fitnessctl journal today          Show today's journal entry
  fitnessctl journal get DATE       Show entry for DATE
  fitnessctl journal list           List all journal entries

  fitnessctl coverage [DAYS]        Muscle coverage (default 7 days)
  fitnessctl gaps [DAYS]            Coverage gaps (default 7 days)

  fitnessctl search QUERY           Search exercises via wger
EOF
}

PIDFILE="/tmp/fitness-dev.pid"
LOGFILE="/tmp/fitness-dev.log"

cmd_start() {
  if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    warn "Already running (PID $(cat "$PIDFILE"))"; return
  fi
  cd "$ROOT"
  nohup node server.mjs >"$LOGFILE" 2>&1 &
  echo $! >"$PIDFILE"
  sleep 0.5
  if kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    msg "Started (PID $(cat "$PIDFILE"), API :${API_PORT})"
  else
    die "Failed to start — check $LOGFILE"
  fi
}

cmd_stop() {
  if [[ -f "$PIDFILE" ]]; then
    local pid; pid="$(cat "$PIDFILE")"
    if kill -0 "$pid" 2>/dev/null; then
      kill "$pid" && rm -f "$PIDFILE"
      msg "Stopped (PID $pid)"
    else
      rm -f "$PIDFILE"; warn "Was not running"
    fi
  else
    warn "No pidfile found"
  fi
}

cmd_status() {
  local api_ok=false ui_ok=false
  curl -fsS --max-time 2 "${API_URL}/health" >/dev/null 2>&1 && api_ok=true
  curl -fsS --max-time 2 "http://${HOST}:${UI_PORT}" >/dev/null 2>&1 && ui_ok=true

  if have_gum; then
    {
      echo "SERVICE,PORT,STATUS"
      echo "fitness-api,${API_PORT},$($api_ok && echo '✓ up' || echo '✗ down')"
      echo "fitness-ui,${UI_PORT},$($ui_ok && echo '✓ up' || echo '✗ down')"
    } | gum table --print --separator=","
  else
    printf "  %-14s :%-6s %s\n" "fitness-api" "$API_PORT" "$($api_ok && echo 'up' || echo 'down')"
    printf "  %-14s :%-6s %s\n" "fitness-ui"  "$UI_PORT"  "$($ui_ok  && echo 'up' || echo 'down')"
  fi
}

cmd_health() {
  local res; res=$(curl -fsS --max-time 3 "${API_URL}/health" 2>&1) || die "API not reachable at ${API_URL}"
  msg "$res"
}

cmd_dev() {
  msg "Starting API + Vite (Ctrl+C to stop)"
  cd "$ROOT" && npm run dev
}

cmd_build() {
  msg "Building Vite → dist/"
  cd "$ROOT" && npm run build
}

cmd_logs() {
  [[ -f "$LOGFILE" ]] || die "No log at $LOGFILE"
  tail -f "$LOGFILE"
}

api_get() { curl -fsS --max-time 5 "${API_URL}$1" 2>&1 || die "Request failed: $1"; }

cmd_session() {
  local sub="${1:-today}"; shift || true
  case "$sub" in
    today)  api_get "/session?date=$(date +%Y-%m-%d)" | python3 -m json.tool ;;
    get)    [[ -n "${1:-}" ]] || die "Usage: session get DATE"; api_get "/session?date=$1" | python3 -m json.tool ;;
    list)   api_get "/session/history?limit=${1:-10}" | python3 -m json.tool ;;
    *)      die "Unknown: session $sub" ;;
  esac
}

cmd_journal() {
  local sub="${1:-today}"; shift || true
  case "$sub" in
    today)  api_get "/journal?date=$(date +%Y-%m-%d)" | python3 -m json.tool ;;
    get)    [[ -n "${1:-}" ]] || die "Usage: journal get DATE"; api_get "/journal?date=$1" | python3 -m json.tool ;;
    list)   api_get "/journal/list" | python3 -m json.tool ;;
    *)      die "Unknown: journal $sub" ;;
  esac
}

cmd_coverage() {
  local days="${1:-7}"
  api_get "/coverage/detailed?days=${days}" | python3 -c "
import sys,json; d=json.load(sys.stdin)
for g in d.get('groups',[]):
    score=sum(m['totalScore'] for m in g['muscles'])
    bar='█'*int(score*2)
    print(f'  {g[\"id\"]:12s} {score:5.1f}  {bar}')
"
}

cmd_gaps() {
  local days="${1:-7}"
  api_get "/coverage/gaps?days=${days}" | python3 -c "
import sys,json; d=json.load(sys.stdin)
gaps=d.get('gaps',[])
if not gaps: print('  No gaps in the last ${days} days')
else: [print(f'  {g[\"name\"]:14s} ({g[\"hits\"]} hits)') for g in gaps]
"
}

cmd_search() {
  [[ -n "${1:-}" ]] || die "Usage: search QUERY"
  api_get "/exercises/search?q=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote('$*'))")" | python3 -c "
import sys,json; d=json.load(sys.stdin)
for r in d.get('results',[]):
    muscles=' '.join(r.get('primaryMuscles',[]))
    print(f'  {r[\"name\"]:30s} {muscles}')
"
}

case "${1:-help}" in
  start)    cmd_start ;;
  stop)     cmd_stop ;;
  restart)  cmd_stop; sleep 0.3; cmd_start ;;
  status)   cmd_status ;;
  health)   cmd_health ;;
  dev)      cmd_dev ;;
  build)    cmd_build ;;
  logs)     cmd_logs ;;
  session)  shift; cmd_session "$@" ;;
  journal)  shift; cmd_journal "$@" ;;
  coverage) shift; cmd_coverage "$@" ;;
  gaps)     shift; cmd_gaps "$@" ;;
  search)   shift; cmd_search "$@" ;;
  help|-h|--help) usage ;;
  *) die "Unknown command: ${1}. Run 'fitnessctl help'" ;;
esac
