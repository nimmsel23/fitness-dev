@app.command()
def coverage(days: int = typer.Option(7, "-d", help="Days to look back")):
    """Muscle coverage analysis."""
    data = _api_get(f"/coverage/detailed?days={days}")
    for g in data.get("groups", []):
        score = sum(m["totalScore"] for m in g["muscles"])
        bar = "█" * int(score * 2)
        print(f"  {g['id']:12s} {score:5.1f}  {bar}")


@app.command()
def gaps(days: int = typer.Option(7, "-d", help="Days to look back")):
    """Show undertrained muscles."""
    data = _api_get(f"/coverage/gaps?days={days}")
    result = data.get("gaps", [])
    if not result:
        msg.good("No gaps")
    else:
        for g in result:
            print(f"  {g['name']:14s} ({g['hits']} hits)")


@app.command()
def search(query: str = typer.Argument(..., help="Exercise search query")):
    """Search exercises."""
    q = urllib.parse.quote(query)
    data = _api_get(f"/exercises/search?q={q}")
    for r in data.get("results", []):
        muscles = " ".join(r.get("primaryMuscles", []))
        print(f"  {r['name']:30s} {muscles}")


if __name__ == "__main__":
    app()
