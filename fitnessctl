#!/usr/bin/env bash
# fitnessctl — manage fitness-dev server (API :9100, UI :5902)
set -euo pipefail

ROOT="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
API_PORT="${FITNESS_API_PORT:-9100}"
UI_PORT="${FITNESS_UI_PORT:-5902}"
HOST="${FITNESS_HOST:-127.0.0.1}"
API_URL="http://${HOST}:${API_PORT}"

have_gum() { command -v gum >/dev/null 2>&1; }
msg()  { have_gum && gum style --foreground 10 "  ✓ $*" || printf '\033[1;32m  %s\033[0m\n' "$*"; }
warn() { have_gum && gum style --foreground 11 "  ! $*" >&2 || printf '\033[1;33m  %s\033[0m\n' "$*" >&2; }
err()  { have_gum && gum style --foreground 9 --bold "  ✗ $*" >&2 || printf '\033[1;31m  %s\033[0m\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

usage() {
  if have_gum; then
    gum format <<EOF
# fitnessctl 
## Fitness Ecosystem Management

| Command | Description |
| :--- | :--- |
| **start** | Start API server (background) |
| **stop** | Stop API server |
| **restart** | Restart API server |
| **status** | Show running status |
| **dev** | Start API + Vite (foreground) |
| **sync** | Pull fresh data from Firebase |
| **kb-sync** | Push local catalog to Firestore |
| **watch** | Start AI Enricher Watcher |
| **session** | Show/List training sessions |
| **journal** | Show/List journal entries |
| **coverage** | Muscle coverage analysis |
| **search** | Search exercises via wger |
EOF
  else
    cat <<EOF
fitnessctl — fitness-dev service control (API :${API_PORT}, UI :${UI_PORT})

  fitnessctl start        Start API server (background)
  fitnessctl stop         Stop API server
  fitnessctl restart      Restart API server
  ...
EOF
  fi
}

PIDFILE="/tmp/fitness-dev.pid"
AGENT_PIDFILE="/tmp/fitness-agent.pid"
LOGFILE="/tmp/fitness-dev.log"
AGENT_LOGFILE="/tmp/fitness-agent.log"

cmd_start() {
  if have_gum; then
    gum spin --spinner pulse --title "Starting Fitness Services..." -- sleep 0.2
  fi
  # Start Agent Server
  if [[ -f "$AGENT_PIDFILE" ]] && kill -0 "$(cat "$AGENT_PIDFILE")" 2>/dev/null; then
    warn "Agent already running (PID $(cat "$AGENT_PIDFILE"))"
  else
    cd "$ROOT"
    PYTHONPATH=catalog nohup python3 -m fitness_agent.server >"$AGENT_LOGFILE" 2>&1 &
    echo $! >"$AGENT_PIDFILE"
    sleep 0.5
    msg "Agent Started (PID $(cat "$AGENT_PIDFILE"), Port :9120)"
  fi

  # Start API Server
  if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    warn "API already running (PID $(cat "$PIDFILE"))"; return
  fi
  cd "$ROOT"
  nohup node server.mjs >"$LOGFILE" 2>&1 &
  echo $! >"$PIDFILE"
  sleep 0.5
  if kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    msg "API Started (PID $(cat "$PIDFILE"), Port :${API_PORT})"
  else
    die "Failed to start API — check $LOGFILE"
  fi
}

cmd_stop() {
  if have_gum; then
    gum spin --spinner pulse --title "Stopping Fitness Services..." -- sleep 0.2
  fi
  # Stop API Server
  ...
  # Stop AI Watcher
  local watch_pidfile="/tmp/fitness-enricher.pid"
  if [[ -f "$watch_pidfile" ]]; then
    local wpid; wpid="$(cat "$watch_pidfile")"
    if kill -0 "$wpid" 2>/dev/null; then
      kill "$wpid" && rm -f "$watch_pidfile"
      msg "Watcher Stopped (PID $wpid)"
    else
      rm -f "$watch_pidfile"; warn "Watcher was not running"
    fi
  fi
}

cmd_status() {
  local api_ok=false ui_ok=false watch_ok=false agent_ok=false
  curl -fsS --max-time 2 "${API_URL}/health" >/dev/null 2>&1 && api_ok=true
  curl -fsS --max-time 2 "http://localhost:${UI_PORT}" >/dev/null 2>&1 && ui_ok=true
  curl -fsS --max-time 2 "http://${HOST}:9120/" >/dev/null 2>&1 && agent_ok=true
  
  local watch_pidfile="/tmp/fitness-enricher.pid"
  if [[ -f "$watch_pidfile" ]] && kill -0 "$(cat "$watch_pidfile")" 2>/dev/null; then
    watch_ok=true
  fi

  if have_gum; then
    {
      echo "SERVICE,PORT,STATUS"
      echo "fitness-api,${API_PORT},$($api_ok && echo '✓ up' || echo '✗ down')"
      echo "fitness-agent,9120,$($agent_ok && echo '✓ up' || echo '✗ down')"
      echo "fitness-ui,${UI_PORT},$($ui_ok && echo '✓ up' || echo '✗ down')"
      echo "ai-enricher,-,$($watch_ok && echo '✓ active' || echo '✗ inactive')"
    } | gum table --print --separator=","
  else
    printf "  %-14s :%-6s %s\n" "fitness-api"   "$API_PORT" "$($api_ok && echo 'up' || echo 'down')"
    printf "  %-14s :%-6s %s\n" "fitness-agent" "9120"      "$($agent_ok && echo 'up' || echo 'down')"
    printf "  %-14s :%-6s %s\n" "fitness-ui"    "$UI_PORT"  "$($ui_ok  && echo 'up' || echo 'down')"
    printf "  %-14s :%-6s %s\n" "ai-enricher"   "-"       "$($watch_ok && echo 'active' || echo 'inactive')"
  fi
}

cmd_health() {
  local res; res=$(curl -fsS --max-time 3 "${API_URL}/health" 2>&1) || die "API not reachable at ${API_URL}"
  msg "$res"
}

cmd_dev() {
  msg "Starting API + Vite (Ctrl+C to stop)"
  cd "$ROOT" && npm run dev
}

cmd_build() {
  msg "Building Vite → dist/"
  cd "$ROOT" && npm run build
}

cmd_logs() {
  [[ -f "$LOGFILE" ]] || die "No log at $LOGFILE"
  tail -f "$LOGFILE"
}

cmd_sync() {
  if have_gum; then
    gum spin --spinner dot --title "Syncing Firestore..." -- python3 -m firestore.sync_cli sync
  else
    msg "Syncing Firestore..."
    cd "$ROOT" && python3 -m firestore.sync_cli sync
  fi
}

cmd_sync_views() {
  msg "Deploying shared views to PWA..."
  cd "$ROOT" && npm run sync-views
}

cmd_watch() {
  local watch_pidfile="/tmp/fitness-enricher.pid"
  local watch_logfile="/tmp/fitness-enricher.log"
  
  if [[ -f "$watch_pidfile" ]] && kill -0 "$(cat "$watch_pidfile")" 2>/dev/null; then
    warn "Watcher already running (PID $(cat "$watch_pidfile"))"; return
  fi
  cd "$ROOT"
  if have_gum; then
    gum spin --spinner pulse --title "Starting AI Watcher..." -- sleep 0.2
  fi
  PYTHONPATH=catalog nohup python3 -m fitness_agent.cli watch >"$watch_logfile" 2>&1 &
  echo $! >"$watch_pidfile"
  sleep 0.5
  if kill -0 "$(cat "$watch_pidfile")" 2>/dev/null; then
    msg "Watcher Started (PID $(cat "$watch_pidfile"))"
  else
    die "Failed to start watcher — check $watch_logfile"
  fi
}

cmd_kb_sync() {
  if have_gum; then
    gum spin --spinner dot --title "Syncing local catalog to Firestore..." -- python3 -c "import sys; sys.path.insert(0, 'catalog'); from fitness_agent.kb_sync import run_kb_sync; run_kb_sync()"
  else
    msg "Syncing local catalog to Firestore..."
    cd "$ROOT" && python3 -c "import sys; sys.path.insert(0, 'catalog'); from fitness_agent.kb_sync import run_kb_sync; run_kb_sync()"
  fi
}

api_get() { curl -fsS --max-time 5 "${API_URL}$1" 2>&1 || die "Request failed: $1"; }

cmd_session() {
  local sub="${1:-today}"; shift || true
  case "$sub" in
    today)  api_get "/session?date=$(date +%Y-%m-%d)" | python3 -m json.tool ;;
    get)    [[ -n "${1:-}" ]] || die "Usage: session get DATE"; api_get "/session?date=$1" | python3 -m json.tool ;;
    list)   api_get "/session/history?limit=${1:-10}" | python3 -m json.tool ;;
    *)      die "Unknown: session $sub" ;;
  esac
}

cmd_journal() {
  local sub="${1:-today}"; shift || true
  case "$sub" in
    today)  api_get "/journal?date=$(date +%Y-%m-%d)" | python3 -m json.tool ;;
    get)    [[ -n "${1:-}" ]] || die "Usage: journal get DATE"; api_get "/journal?date=$1" | python3 -m json.tool ;;
    list)   api_get "/journal/list" | python3 -m json.tool ;;
    *)      die "Unknown: journal $sub" ;;
  esac
}

cmd_coverage() {
  local days="${1:-7}"
  if have_gum; then
     msg "Calculating muscle coverage for last ${days} days..."
  fi
  api_get "/coverage/detailed?days=${days}" | python3 - <<EOF
import sys,json
d=json.load(sys.stdin)
for g in d.get('groups',[]):
    score=sum(m['totalScore'] for m in g['muscles'])
    bar='█'*int(score*2)
    print(f'  {g["id"]:12s} {score:5.1f}  {bar}')
EOF
}

cmd_gaps() {
  local days="${1:-7}"
  api_get "/coverage/gaps?days=${days}" | python3 - <<EOF
import sys,json
d=json.load(sys.stdin)
gaps=d.get('gaps',[])
if not gaps: print('  No gaps in the last ${days} days')
else: [print(f'  {g["name"]:14s} ({g["hits"]} hits)') for g in gaps]
EOF
}

cmd_search() {
  [[ -n "${1:-}" ]] || die "Usage: search QUERY"
  local query; query=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote('$*'))")
  api_get "/exercises/search?q=${query}" | python3 - <<EOF
import sys,json
d=json.load(sys.stdin)
for r in d.get('results',[]):
    muscles=' '.join(r.get('primaryMuscles',[]))
    print(f'  {r["name"]:30s} {muscles}')
EOF
}

# --- Interactive Main ---
if [[ -z "${1:-}" ]] && have_gum; then
  CHOICE=$(gum choose "status" "sync" "kb-sync" "start" "stop" "restart" "dev" "watch" "coverage" "gaps" "logs" "help" "exit")
  [[ "$CHOICE" == "exit" ]] && exit 0
  set -- "$CHOICE"
fi

case "${1:-help}" in
  start)      cmd_start ;;
  stop)       cmd_stop ;;
  restart)    cmd_stop; sleep 0.3; cmd_start ;;
  status)     cmd_status ;;
  health)     cmd_health ;;
  dev)        cmd_dev ;;
  build)      cmd_build ;;
  logs)       cmd_logs ;;
  sync)       cmd_sync ;;
  sync-views) cmd_sync_views ;;
  watch)      cmd_watch ;;
  kb-sync)    cmd_kb_sync ;;
  session)    shift; cmd_session "$@" ;;
  journal)    shift; cmd_journal "$@" ;;
  coverage)   shift; cmd_coverage "$@" ;;
  gaps)       shift; cmd_gaps "$@" ;;
  search)     shift; cmd_search "$@" ;;
  help|-h|--help) usage ;;
  *) die "Unknown command: ${1}. Run 'fitnessctl help'" ;;
esac
