#!/usr/bin/env python3
"""
anatomy-agent — Dispatcher für das anatomy-kb System

Subcommands:
  serve               Server starten (:9200)
  list                Alle Übungen auflisten
  show <id>           Vollständige YAML-Daten einer Übung
  teaching <id>       Anatomy-Teaching-Felder
  errors <id>         common_errors_explained
  quiz <id>           quiz_prompts
  reload              YAML-Cache des laufenden Servers leeren
  doctor              System-Health prüfen

Beispiele:
  anatomy-agent list
  anatomy-agent show bench_press
  anatomy-agent teaching pull_up
  anatomy-agent quiz squat
  anatomy-agent serve
  anatomy-agent serve --port 9201
"""

import subprocess
import sys
from pathlib import Path

import typer
import yaml
from loguru import logger

# Projekt-Root zum Suchpfad hinzufügen damit anatomy_kb importierbar ist
ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))

from anatomy_kb import loader
from anatomy_kb.models import Exercise

app = typer.Typer(
    name="anatomy-agent",
    help="Anatomy Knowledge Base — CLI Dispatcher",
    add_completion=False,
)

EXERCISES_DIR = ROOT / "exercises"
SERVER_PORT = 9200

# gum Guard: ANSI-Fallback wenn gum nicht verfügbar
def _have_gum() -> bool:
    return subprocess.run(["which", "gum"], capture_output=True).returncode == 0


def _gum_log(level: str, msg: str) -> None:
    if _have_gum():
        subprocess.run(["gum", "log", f"--level={level}", msg])
    else:
        print(f"[{level.upper()}] {msg}")


def _gum_table(headers: list[str], rows: list[list[str]]) -> None:
    if not rows:
        print("(keine Einträge)")
        return
    if _have_gum():
        lines = ["\t".join(headers)]
        lines += ["\t".join(r) for r in rows]
        subprocess.run(
            ["gum", "table", "--print", '--separator=\t'],
            input="\n".join(lines),
            text=True,
        )
    else:
        col_w = [max(len(h), max((len(r[i]) for r in rows), default=0)) for i, h in enumerate(headers)]
        fmt = "  ".join(f"{{:<{w}}}" for w in col_w)
        print(fmt.format(*headers))
        print("  ".join("-" * w for w in col_w))
        for row in rows:
            print(fmt.format(*row))


def _init_loader() -> None:
    loader.init(EXERCISES_DIR)


# --- Subcommands -------------------------------------------------------------

@app.command()
def serve(port: int = typer.Option(SERVER_PORT, help="Port")):
    """aiohttp API-Server starten."""
    _gum_log("info", f"anatomy-kb server startet auf :{port}")
    import subprocess as sp
    sp.run([sys.executable, str(ROOT / "server.py"), "--port", str(port)])


@app.command("list")
def list_exercises():
    """Alle Übungen als Tabelle ausgeben."""
    _init_loader()
    all_data = loader.load_all()
    if not all_data:
        _gum_log("warn", "Keine Übungen gefunden")
        raise typer.Exit(1)

    rows = []
    for data in all_data.values():
        ex = Exercise.from_dict(data)
        primary = ", ".join(ex.muscle_roles.primary[:3])
        rows.append([ex.exercise_id, ex.name, ex.category, ex.movement_pattern, primary])

    _gum_table(
        ["ID", "Name", "Kategorie", "Muster", "Primäre Muskeln"],
        rows,
    )


@app.command()
def show(exercise_id: str = typer.Argument(..., help="exercise_id z.B. bench_press")):
    """Vollständige YAML-Daten einer Übung ausgeben."""
    _init_loader()
    data = loader.load_one(exercise_id)
    if data is None:
        _gum_log("error", f"Übung nicht gefunden: {exercise_id}")
        raise typer.Exit(1)
    print(yaml.dump(data, allow_unicode=True, default_flow_style=False, sort_keys=False))


@app.command()
def teaching(exercise_id: str = typer.Argument(..., help="exercise_id")):
    """Anatomy-Teaching-Felder: Erklärung, Gelenke, Muskeln, Feel-Cues."""
    _init_loader()
    data = loader.load_one(exercise_id)
    if data is None:
        _gum_log("error", f"Übung nicht gefunden: {exercise_id}")
        raise typer.Exit(1)

    ex = Exercise.from_dict(data)

    print(f"\n{'='*60}")
    print(f"  {ex.name}")
    print(f"{'='*60}\n")

    print("KURZ:")
    print(f"  {ex.simple_explanation.strip()}\n")

    print("DETAIL:")
    for line in ex.detailed_explanation.strip().splitlines():
        print(f"  {line.strip()}")
    print()

    if data.get("joint_actions"):
        print("GELENKAKTIONEN:")
        for joint, phases in data["joint_actions"].items():
            if isinstance(phases, dict):
                for phase, actions in phases.items():
                    if isinstance(actions, list):
                        print(f"  {joint} / {phase}: {', '.join(actions)}")
                    elif isinstance(actions, str):
                        print(f"  {joint} / {phase}: {actions}")
            elif isinstance(phases, list):
                print(f"  {joint}: {', '.join(phases)}")
        print()

    if ex.muscle_roles.primary:
        print("MUSKELN:")
        print(f"  Primär:       {', '.join(ex.muscle_roles.primary)}")
        if ex.muscle_roles.secondary:
            print(f"  Sekundär:     {', '.join(ex.muscle_roles.secondary)}")
        if ex.muscle_roles.stabilizers:
            print(f"  Stabilisator: {', '.join(ex.muscle_roles.stabilizers)}")
        print()

    if ex.feel_cues:
        print("KÖRPERGEFÜHL:")
        for cue in ex.feel_cues:
            print(f"  → {cue}")
        print()


@app.command()
def errors(exercise_id: str = typer.Argument(..., help="exercise_id")):
    """Fehlerbilder mit anatomischer Erklärung und Korrektur."""
    _init_loader()
    data = loader.load_one(exercise_id)
    if data is None:
        _gum_log("error", f"Übung nicht gefunden: {exercise_id}")
        raise typer.Exit(1)

    common_errors = data.get("common_errors_explained")
    if not common_errors:
        _gum_log("warn", f"Keine Fehlerbilder für {exercise_id}")
        return

    ex = Exercise.from_dict(data)
    print(f"\n{ex.name} — Fehlerbilder\n{'='*50}\n")

    for error_id, error in common_errors.items():
        print(f"[{error_id}]")
        print(f"  Problem:    {error.get('description', '')}")
        reason = error.get("anatomical_reason", "").strip().replace("\n", " ")
        print(f"  Anatomie:   {reason}")
        print(f"  Korrektur:  {error.get('correction', '')}")
        teaches = error.get("teaches", [])
        if teaches:
            print(f"  Lehrt:      {', '.join(teaches)}")
        print()


@app.command()
def quiz(exercise_id: str = typer.Argument(..., help="exercise_id")):
    """Quiz-Prompts mit Fragen und Antworten."""
    _init_loader()
    data = loader.load_one(exercise_id)
    if data is None:
        _gum_log("error", f"Übung nicht gefunden: {exercise_id}")
        raise typer.Exit(1)

    prompts = data.get("quiz_prompts") or []
    if not prompts:
        _gum_log("warn", f"Keine Quiz-Prompts für {exercise_id}")
        return

    ex = Exercise.from_dict(data)
    print(f"\n{ex.name} — Quiz\n{'='*50}\n")

    for i, prompt in enumerate(prompts, 1):
        print(f"F{i}: {prompt.get('question', '').strip()}")
        print()
        answer = prompt.get("answer", "").strip().replace("\n", " ")
        print(f"A{i}: {answer}")
        print()


@app.command()
def reload():
    """YAML-Cache des laufenden Servers leeren (POST /api/reload)."""
    try:
        import urllib.request
        req = urllib.request.Request(
            f"http://localhost:{SERVER_PORT}/api/reload",
            method="POST",
        )
        with urllib.request.urlopen(req, timeout=3) as resp:
            _gum_log("info", f"Server-Cache geleert: {resp.read().decode()}")
    except Exception as e:
        _gum_log("warn", f"Server nicht erreichbar ({e}) — lokalen Cache leere ich direkt")
        _init_loader()
        loader.reload()
        _gum_log("info", "Lokaler Cache geleert")


@app.command()
def doctor():
    """System-Health prüfen: Verzeichnisse, YAMLs, Server."""
    rows = []

    def check(label: str, ok: bool, detail: str = "") -> None:
        status = "OK" if ok else "FAIL"
        rows.append([status, label, detail])

    check("exercises_dir", EXERCISES_DIR.exists(), str(EXERCISES_DIR))

    yml_files = list(EXERCISES_DIR.glob("*.yml")) if EXERCISES_DIR.exists() else []
    check("exercises yml gefunden", len(yml_files) > 0, f"{len(yml_files)} Dateien")

    parse_errors = []
    for f in yml_files:
        try:
            yaml.safe_load(f.read_text())
        except yaml.YAMLError:
            parse_errors.append(f.name)
    check("yaml parse", len(parse_errors) == 0, ", ".join(parse_errors) if parse_errors else "alle ok")

    check("server.py", (ROOT / "server.py").exists(), "")
    check("anatomy_kb/loader.py", (ROOT / "anatomy_kb" / "loader.py").exists(), "")
    check("anatomy_kb/models.py", (ROOT / "anatomy_kb" / "models.py").exists(), "")

    try:
        import urllib.request
        urllib.request.urlopen(f"http://localhost:{SERVER_PORT}/health", timeout=2)
        check(f"server :{SERVER_PORT}", True, "erreichbar")
    except Exception:
        check(f"server :{SERVER_PORT}", False, "nicht erreichbar (starte mit: anatomy-agent serve)")

    _gum_table(["Status", "Check", "Detail"], rows)

    failed = [r for r in rows if r[0] == "FAIL"]
    if failed:
        _gum_log("error", f"{len(failed)} Check(s) fehlgeschlagen")
        raise typer.Exit(1)
    else:
        _gum_log("info", "anatomy-kb: alles ok")


# --- Entry Point -------------------------------------------------------------

if __name__ == "__main__":
    app()
