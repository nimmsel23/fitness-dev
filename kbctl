#!/usr/bin/env bash
# kbctl — anatomy-kb server control (:9200)
set -euo pipefail

ROOT="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
PORT="${ANATOMY_KB_PORT:-9200}"
HOST="${ANATOMY_KB_HOST:-127.0.0.1}"
URL="http://${HOST}:${PORT}"
PIDFILE="/tmp/anatomy-kb.pid"
LOGFILE="/tmp/anatomy-kb.log"

have_gum() { command -v gum >/dev/null 2>&1; }
msg()  { have_gum && gum log --level info  "$*" || printf '\033[1;32m  %s\033[0m\n' "$*"; }
warn() { have_gum && gum log --level warn  "$*" >&2 || printf '\033[1;33m  %s\033[0m\n' "$*" >&2; }
err()  { have_gum && gum log --level error "$*" >&2 || printf '\033[1;31m  %s\033[0m\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

usage() {
  cat <<EOF
kbctl — anatomy-kb server control (:${PORT})

  kbctl start          Server starten (background)
  kbctl stop           Server stoppen
  kbctl restart        Restart
  kbctl status         PID + Port + Uptime
  kbctl health         /health Endpoint prüfen
  kbctl logs           Server-Log live verfolgen

  kbctl list           Alle Übungen
  kbctl resolve QUERY  Alias-/Fuzzy-Resolver
  kbctl bodymap ID     BodyMap-Regions für eine Übung

Env:
  ANATOMY_KB_PORT   (default: 9200)
  ANATOMY_KB_HOST   (default: 127.0.0.1)
EOF
}

# --- Server-Kontrolle --------------------------------------------------------

cmd_start() {
  if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    warn "Läuft bereits (PID $(cat "$PIDFILE"))"; return
  fi
  cd "$ROOT"
  nohup python3 server.py --port "$PORT" >"$LOGFILE" 2>&1 &
  echo $! >"$PIDFILE"
  sleep 1
  if kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    msg "Gestartet (PID $(cat "$PIDFILE"), :${PORT})"
  else
    die "Start fehlgeschlagen — siehe $LOGFILE"
  fi
}

cmd_stop() {
  if [[ ! -f "$PIDFILE" ]]; then warn "Kein PID-File — läuft nicht?"; return; fi
  local pid; pid=$(cat "$PIDFILE")
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" && rm -f "$PIDFILE"
    msg "Gestoppt (PID $pid)"
  else
    warn "Prozess $pid nicht gefunden — PID-File entfernt"
    rm -f "$PIDFILE"
  fi
}

cmd_restart() { cmd_stop; sleep 0.5; cmd_start; }

cmd_status() {
  local rows=()
  local pid="—" uptime="—" port_status="—"

  if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    pid=$(cat "$PIDFILE")
    uptime=$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ' || echo "?")
    port_status="up"
  else
    port_status="down"
  fi

  if have_gum; then
    printf "Service\tPID\tPort\tUptime\tStatus\n%s\t%s\t%s\t%s\t%s\n" \
      "anatomy-kb" "$pid" ":${PORT}" "$uptime" "$port_status" \
      | gum table --print --separator=$'\t'
  else
    printf "  %-15s %-8s %-8s %-10s %s\n" "Service" "PID" "Port" "Uptime" "Status"
    printf "  %-15s %-8s %-8s %-10s %s\n" "anatomy-kb" "$pid" ":${PORT}" "$uptime" "$port_status"
  fi
}

cmd_health() {
  if command -v http >/dev/null 2>&1; then
    http --check-status GET "${URL}/health" 2>/dev/null \
      && msg "Health OK" \
      || die "Health check fehlgeschlagen — läuft der Server? (kbctl start)"
  else
    curl -fsS "${URL}/health" \
      && msg "Health OK" \
      || die "Health check fehlgeschlagen — läuft der Server? (kbctl start)"
  fi
}

cmd_logs() {
  [[ -f "$LOGFILE" ]] || die "Kein Log-File: $LOGFILE"
  tail -f "$LOGFILE"
}

# --- API-Shortcuts -----------------------------------------------------------

cmd_list() {
  _require_server
  if command -v http >/dev/null 2>&1; then
    http GET "${URL}/api/exercises" | python3 -c "
import json, sys
data = json.load(sys.stdin)
rows = [['ID','Name','Muster','Primär']]
for e in data:
    rows.append([e['exercise_id'], e.get('german') or e['display_name'],
                 e.get('movement_pattern',''), ', '.join(e.get('primary_muscles',[])[:3])])
$(have_gum && echo "
import subprocess
lines = ['\\t'.join(r) for r in rows]
subprocess.run(['gum','table','--print','--separator=\\t'], input='\\n'.join(lines), text=True)
" || echo "
for r in rows: print('  '.join(f'{c:<22}' for c in r))
")
" 2>/dev/null || curl -fsS "${URL}/api/exercises"
  fi
}

cmd_resolve() {
  _require_server
  local q="${1:-}"; [[ -n "$q" ]] || die "Usage: kbctl resolve QUERY"
  if command -v http >/dev/null 2>&1; then
    http GET "${URL}/api/resolve" "q==$q"
  else
    curl -fsS "${URL}/api/resolve?q=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$q")"
  fi
}

cmd_bodymap() {
  _require_server
  local id="${1:-}"; [[ -n "$id" ]] || die "Usage: kbctl bodymap EXERCISE_ID"
  if command -v http >/dev/null 2>&1; then
    http GET "${URL}/api/exercise/${id}/bodymap"
  else
    curl -fsS "${URL}/api/exercise/${id}/bodymap"
  fi
}

_require_server() {
  if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then return; fi
  die "Server nicht erreichbar — starte mit: kbctl start"
}

# --- Dispatch ----------------------------------------------------------------

cmd="${1:-help}"
shift || true

case "$cmd" in
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_restart ;;
  status)  cmd_status ;;
  health)  cmd_health ;;
  logs)    cmd_logs ;;
  list)    cmd_list ;;
  resolve) cmd_resolve "$@" ;;
  bodymap) cmd_bodymap "$@" ;;
  help|--help|-h) usage ;;
  *) err "Unbekannter Befehl: $cmd"; usage; exit 1 ;;
esac
