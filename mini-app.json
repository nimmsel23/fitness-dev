{
  "defaults": {},
  "apps": {
    "fitness": {
      "id": "fitness",
      "name": "Fitness Centre",
      "short": "Fitness",
      "accent": "#e8a020",
      "sw": {
        "prefix": "fitness-",
        "shell": [
          "./",
          "./index.html",
          "./offline-queue.js",
          "./manifest.json"
        ],
        "cacheAllSameOrigin": true,
        "navTimeoutMs": null,
        "api": {
          "swr": [
            "/session",
            "/coverage",
            "/fitness/weekly",
            "/fitness/body",
            "/fitness/plan",
            "/fitness/inbox",
            "/fitness/clients",
            "/fitness/config",
            "/fitness/muscles",
            "/fitness/search",
            "/fitness/exercises",
            "/exercises/search",
            "/exercises/by-group",
            "/exercise",
            "/journal",
            "/habitsync",
            "/plan/today",
            "/blocks",
            "/theme",
            "/health"
          ]
        },
        "imageCaches": [
          {
            "cache": "fitness-exercise-images",
            "hosts": [
              "cdn.jsdelivr.net"
            ]
          }
        ],
        "sync": {
          "tag": "fitness-flush-queue",
          "db": "aos-offline-fitness"
        },
        "extras": [
          "workout-notifications"
        ],
        "workoutLink": "./#session/today",
        "notificationLink": "./#session/today"
      },
      "splash": {
        "icon": "/icon-192.png"
      }
    },
    "frontend": {
      "id": "fitness",
      "name": "Fitness Centre",
      "short": "Fitness",
      "accent": "#e8a020",
      "sw": {
        "prefix": "fitness-",
        "shell": [
          "./",
          "./index.html",
          "./offline-queue.js",
          "./manifest.json"
        ],
        "cacheAllSameOrigin": true,
        "navTimeoutMs": null,
        "api": {
          "swr": [
            "/api/users",
            "/api/clients",
            "/api/plan",
            "/api/catalog",
            "/session",
            "/coverage",
            "/fitness/weekly",
            "/fitness/body",
            "/fitness/plan",
            "/fitness/inbox",
            "/fitness/clients",
            "/fitness/config",
            "/fitness/muscles",
            "/fitness/search",
            "/fitness/exercises",
            "/exercises/search",
            "/exercises/by-group",
            "/exercise",
            "/journal",
            "/habitsync",
            "/plan/today",
            "/blocks",
            "/theme",
            "/health"
          ]
        },
        "imageCaches": [
          {
            "cache": "fitness-exercise-images",
            "hosts": [
              "cdn.jsdelivr.net"
            ]
          }
        ],
        "sync": {
          "tag": "fitness-flush-queue",
          "db": "aos-offline-fitness",
          "conflicts": true,
          "conflictMessage": "fitness:queue-conflict"
        },
        "extras": [
          "workout-notifications"
        ],
        "workoutLink": "./#session/today",
        "notificationLink": "./#session/today",
        "neverCache": [
          "/api/"
        ]
      }
    },
    "plan": {
      "id": "plan",
      "name": "VitalOS Plan",
      "short": "Plan",
      "description": "Trainingspläne bauen und verwalten",
      "accent": "#5b8cff",
      "iconDir": "solo-icons/plan",
      "html": "index.html",
      "manifest": "plan-manifest.webmanifest",
      "start": "./",
      "scope": "./",
      "register": { "expose": true },
      "sw": {
        "file": "plan-sw.js",
        "prefix": "vos-plan-",
        "shell": ["./", "./index.html", "./plan-manifest.webmanifest"],
        "extras": ["workout-notifications"]
      }
    }
  }
}
