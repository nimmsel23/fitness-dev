{
  "_note": "Firestore rules SSOT = ~/vitalos/firestore.rules \u2014 NEVER add a firestore block here or deploy rules from fitness-dev. Only vitalos deploys rules.",
  "hosting": [
    {
      "target": "client",
      "public": "dist-firebase",
      "redirects": [
        { "source": "/@(6pack|sixpack)", "destination": "/#session/timer", "type": 302 }
      ],
      "ignore": [
        "firebase.json",
        "**/.DS_Store",
        "**/.git/**",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "/sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "**/*.@(js|css|woff2)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "/fitness-messaging-sw.js",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache"
            }
          ]
        },
        {
          "source": "/videos/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600"
            }
          ]
        }
      ]
    },
