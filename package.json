{
  "name": "fitness-dev",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "cloud_chamber/journal-dev",
    "cloud_chamber/learn-dev",
    "cloud_chamber/vitalos"
  ],
  "scripts": {
    "predev": "npm run build:sixpack-data",
    "dev": "node scripts/dev-runner.mjs",
    "start": "node server.mjs",
    "ui:dev": "vite",
    "lint": "eslint src/ --ext .js,.jsx",
    "prebuild": "npm run build:sixpack-data",
    "build": "npm run lint && vite build && node scripts/snapshot.mjs dist",
    "build:preview": "npm run deploy:preview",
    "prebuild:firebase": "npm run build:sixpack-data",
    "build:sixpack-data": "node scripts/build-sixpack-data.mjs",
    "build:firebase": "vite build --mode firebase --outDir dist-firebase && node scripts/stamp-sw.mjs dist-firebase && node scripts/snapshot.mjs dist-firebase",
    "stamp:sw": "node scripts/stamp-sw.mjs dist-firebase",
    "preview:firebase": "firebase hosting:channel:deploy preview --expires 1h",
    "deploy:firebase": "firebase deploy --only hosting",
    "firebase": "npm run build:firebase && npm run deploy:firebase",
    "deploy": "node scripts/deploy-runner.mjs",
    "deploy:local": "./deploy.sh staging",
    "deploy:prod": "./deploy.sh prod",
    "preview": "vite preview",
    "build:catalog": "python3 scripts/build-catalog.py",
    "deploy:preview": "npm run build:firebase && node scripts/deploy-preview.mjs",
    "deploy:prev": "npm run deploy:preview",
    "build:prev": "npm run deploy:preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.3",
    "@tanstack/react-query": "^5.101.0",
    "better-sqlite3": "^12.10.0",
    "body-muscles": "^1.0.0",
    "date-fns": "^4.4.0",
    "firebase": "^11.10.0",
    "firebase-admin": "^12.7.0",
    "hono": "^4.12.19",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.453.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "^18.3.1",
    "react-body-highlighter": "^2.0.5",
    "react-dom": "^18.3.1",
    "react-is": "^19.2.7",
    "react-muscle-highlighter": "^1.2.0",
    "recharts": "^3.8.1",
    "zustand": "^5.0.14"
  },
  "optionalDependencies": {
    "@vos/cross-app-aliases": "1.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@originjs/vite-plugin-federation": "^1.4.1",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.6.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^0.20.0"
  },
  "allowScripts": {
    "better-sqlite3@12.10.0": true
  }
}
