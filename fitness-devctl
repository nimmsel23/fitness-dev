#!/usr/bin/env python3
"""
fitness-devctl — Fitness Centre Stack Control
Controls: Node API (:9100, aos-fitness-dev.service) + Python Backend (:9150, fitness-python-backend.service)
Deploy: ~/fitness-dev → /opt/fitness (fitness.service, system scope, sudo)

Terminal-facing dispatcher: ~/fitness/bin/fitness (domain CLI, catalog, sessions, coverage etc.)
This script handles ONLY: service control + deploy.
"""

import os
import subprocess
import sys
import time
from pathlib import Path
from typing import Optional
import urllib.request

import typer
from wasabi import Printer

msg = Printer()

app = typer.Typer(help="Fitness Centre Stack Control", no_args_is_help=True)

# ── Config ────────────────────────────────────────────────────────────────────

DEV_DIR = Path(__file__).resolve().parent
NODE_SERVICE = os.getenv("FITNESS_NODE_SERVICE", "aos-fitness-dev.service")
PYTHON_SERVICE = os.getenv("FITNESS_PYTHON_SERVICE", "fitness-python-backend.service")
NODE_PORT = os.getenv("FITNESS_NODE_PORT", "9100")
PYTHON_PORT = os.getenv("FITNESS_PYTHON_PORT", "9150")
NODE_URL = f"http://127.0.0.1:{NODE_PORT}"
PYTHON_URL = f"http://127.0.0.1:{PYTHON_PORT}"
LOGFILE_NODE = Path("/tmp/fitness-node.log")
LOGFILE_PYTHON = Path("/tmp/fitness-python.log")

# ── Helpers ───────────────────────────────────────────────────────────────────

def _http_ok(url: str, timeout: float = 2.0) -> bool:
    try:
        urllib.request.urlopen(url, timeout=timeout)
        return True
    except Exception:
        return False

def _service_active(unit: str) -> bool:
    r = subprocess.run(
        ["systemctl", "--user", "is-active", "--quiet", unit],
        capture_output=True,
    )
    return r.returncode == 0

def _service_enabled(unit: str) -> bool:
    r = subprocess.run(
        ["systemctl", "--user", "is-enabled", "--quiet", unit],
        capture_output=True,
    )
    return r.returncode == 0

def _ctl(unit: str, *args: str) -> int:
    r = subprocess.run(["systemctl", "--user", *args, unit])
    return r.returncode

def _label(ok: bool, yes: str = "up", no: str = "down") -> str:
    return yes if ok else no

# ── Commands ──────────────────────────────────────────────────────────────────

@app.command()
def status():
    """Show service + health status for all fitness-dev services."""
    node_active = _service_active(NODE_SERVICE)
    node_enabled = _service_enabled(NODE_SERVICE)
    node_health = _http_ok(NODE_URL)
    py_active = _service_active(PYTHON_SERVICE)
    py_enabled = _service_enabled(PYTHON_SERVICE)
    py_health = _http_ok(PYTHON_URL)

    msg.divider("Fitness Dev Stack")
    print(f"  {'Service':<30} {'Active':<10} {'Boot':<10} {'Health'}")
    print(f"  {'-'*60}")
    print(f"  {NODE_SERVICE:<30} {_label(node_active):<10} {_label(node_enabled,'enabled','disabled'):<10} {_label(node_health)}")
    print(f"  {PYTHON_SERVICE:<30} {_label(py_active):<10} {_label(py_enabled,'enabled','disabled'):<10} {_label(py_health)}")
    print()
    print(f"  Node API:    {NODE_URL}")
    print(f"  Python Backend: {PYTHON_URL}")


@app.command()
def start(
    node: bool = typer.Option(True, help="Start Node API service"),
    python: bool = typer.Option(True, help="Start Python Backend service"),
):
    """Start fitness-dev services via systemd."""
    if node:
        msg.info(f"Starting {NODE_SERVICE}...")
        rc = _ctl(NODE_SERVICE, "start")
        if rc == 0:
            msg.good(f"{NODE_SERVICE} started")
        else:
            msg.fail(f"Failed to start {NODE_SERVICE}")

    if python:
        msg.info(f"Starting {PYTHON_SERVICE}...")
        rc = _ctl(PYTHON_SERVICE, "start")
        if rc == 0:
            msg.good(f"{PYTHON_SERVICE} started")
        else:
            msg.fail(f"Failed to start {PYTHON_SERVICE}")

    time.sleep(1)
    _wait_healthy(NODE_URL if node else None, PYTHON_URL if python else None)


@app.command()
def stop(
    node: bool = typer.Option(True, help="Stop Node API service"),
    python: bool = typer.Option(True, help="Stop Python Backend service"),
):
    """Stop fitness-dev services."""
    if node:
        _ctl(NODE_SERVICE, "stop")
        msg.good(f"{NODE_SERVICE} stopped")
    if python:
        _ctl(PYTHON_SERVICE, "stop")
        msg.good(f"{PYTHON_SERVICE} stopped")


@app.command()
def restart(
    node: bool = typer.Option(True, help="Restart Node API service"),
    python: bool = typer.Option(True, help="Restart Python Backend service"),
):
    """Restart fitness-dev services."""
    if node:
        _ctl(NODE_SERVICE, "restart")
        msg.good(f"{NODE_SERVICE} restarted")
    if python:
        _ctl(PYTHON_SERVICE, "restart")
        msg.good(f"{PYTHON_SERVICE} restarted")
    time.sleep(1)
    _wait_healthy(NODE_URL if node else None, PYTHON_URL if python else None)


@app.command()
def enable(
    node: bool = typer.Option(True, help="Enable Node API autostart"),
    python: bool = typer.Option(True, help="Enable Python Backend autostart"),
):
    """Enable autostart on boot for fitness-dev services."""
    if node:
        _ctl(NODE_SERVICE, "enable")
        msg.good(f"{NODE_SERVICE} enabled (autostart)")
    if python:
        _ctl(PYTHON_SERVICE, "enable")
        msg.good(f"{PYTHON_SERVICE} enabled (autostart)")


@app.command()
def disable(
    node: bool = typer.Option(True, help="Disable Node API autostart"),
    python: bool = typer.Option(True, help="Disable Python Backend autostart"),
):
    """Disable autostart for fitness-dev services."""
    if node:
        _ctl(NODE_SERVICE, "disable")
        msg.good(f"{NODE_SERVICE} disabled")
    if python:
        _ctl(PYTHON_SERVICE, "disable")
        msg.good(f"{PYTHON_SERVICE} disabled")


@app.command()
def health():
    """Quick HTTP health check for both backends."""
    node_ok = _http_ok(NODE_URL)
    python_ok = _http_ok(PYTHON_URL)
    if node_ok:
        msg.good(f"Node API online ({NODE_URL})")
    else:
        msg.fail(f"Node API offline ({NODE_URL})")
    if python_ok:
        msg.good(f"Python Backend online ({PYTHON_URL})")
    else:
        msg.fail(f"Python Backend offline ({PYTHON_URL})")
    if not (node_ok and python_ok):
        raise typer.Exit(1)


@app.command()
def logs(
    service: str = typer.Argument("node", help="Which service: node | python | agent"),
    follow: bool = typer.Option(True, "-f/--no-follow", help="Follow log output"),
):
    """Follow systemd journal logs for a fitness service."""
    unit_map = {
        "node": NODE_SERVICE,
        "python": PYTHON_SERVICE,
        "agent": "fitness-python-backend.service",
    }
    unit = unit_map.get(service)
    if not unit:
        msg.fail(f"Unknown service '{service}'. Use: node | python | agent")
        raise typer.Exit(1)

    cmd = ["journalctl", "--user", "-u", unit]
    if follow:
        cmd += ["-f", "--no-pager"]
    else:
        cmd += ["-n", "50", "--no-pager"]
    subprocess.run(cmd)


@app.command()
def dev():
    """Start Node API + Vite dev server in foreground (Ctrl+C to stop)."""
    msg.divider("Foreground Dev Mode (Ctrl+C to stop)")
    try:
        subprocess.run(["npm", "run", "dev"], cwd=DEV_DIR)
    except KeyboardInterrupt:
        print()
        msg.info("Stopped.")


@app.command()
def pydev():
    """Stop the systemd Python backend and run catalog.api --reload in foreground (Ctrl+C to restart the service)."""
    was_active = _service_active(PYTHON_SERVICE)
    if was_active:
        msg.info(f"Stopping {PYTHON_SERVICE} (port {PYTHON_PORT} freed for foreground reload)...")
        _ctl(PYTHON_SERVICE, "stop")

    msg.divider("Foreground Python Reload Mode (Ctrl+C to stop)")
    try:
        subprocess.run(
            [sys.executable, "-m", "fitness.catalog.api.api", "serve", "--port", PYTHON_PORT, "--reload"],
            cwd=DEV_DIR,
        )
    except KeyboardInterrupt:
        print()
        msg.info("Stopped.")
    finally:
        if was_active:
            msg.info(f"Restarting {PYTHON_SERVICE}...")
            _ctl(PYTHON_SERVICE, "start")
            msg.good(f"{PYTHON_SERVICE} back up")


@app.command()
def build(
    firebase: bool = typer.Option(False, "--firebase", help="Build Firebase/cloud variant"),
):
    """Run Vite production build."""
    script = "build:firebase" if firebase else "build"
    msg.info(f"Running: npm run {script}")
    subprocess.run(["npm", "run", script], cwd=DEV_DIR)


@app.command()
def deploy(
    dry_run: bool = typer.Option(False, "--dry-run", help="Show what would happen, no changes"),
    skip_build: bool = typer.Option(False, "--skip-build", help="Skip npm build step"),
):
    """Deploy ~/fitness-dev → /opt/fitness (sudo, restarts fitness.service)."""
    dest = Path("/opt/fitness")
    backup_dir = Path("/opt/fitness_backups")

    if dry_run:
        msg.info(f"DRY RUN — would sync {DEV_DIR} → {dest}")
        msg.info(f"Would backup to {backup_dir}/fitness_<timestamp>/")
        msg.info("Would run: npm install + npm run build in /opt/fitness")
        msg.info("Would run: sudo systemctl restart fitness.service")
        return

    # Confirm before destructive sudo op
    import shutil
    if not shutil.which("gum"):
        ans = input(f"Deploy {DEV_DIR} → {dest} and restart fitness.service? [y/N] ")
        if ans.lower() != "y":
            msg.warn("Aborted.")
            raise typer.Exit(0)
    else:
        r = subprocess.run(["gum", "confirm", f"Deploy to {dest} and restart fitness.service?"])
        if r.returncode != 0:
            msg.warn("Aborted.")
            raise typer.Exit(0)

    import datetime
    ts = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
    backup_path = backup_dir / f"fitness_{ts}"

    # 1. Backup
    if dest.exists():
        msg.info(f"Backup: {dest} → {backup_path}")
        subprocess.run(["sudo", "mkdir", "-p", str(backup_dir)], check=True)
        subprocess.run(["sudo", "cp", "-a", str(dest), str(backup_path)], check=True)

    # 2. Rsync
    if not dest.exists():
        msg.info(f"Creating {dest}")
        subprocess.run(["sudo", "mkdir", "-p", str(dest)], check=True)
        subprocess.run(["sudo", "chown", f"{os.getuid()}:{os.getgid()}", str(dest)], check=True)

    msg.info(f"Syncing {DEV_DIR}/ → {dest}/")
    subprocess.run([
        "sudo", "rsync", "-av", "--delete",
        "--exclude=.git", "--exclude=node_modules", "--exclude=data",
        "--exclude=.archiv", "--exclude=*.bak",
        f"{DEV_DIR}/", f"{dest}/",
    ], check=True)

    # 3. npm install + build
    subprocess.run(["sudo", "chown", "-R", f"{os.getuid()}:{os.getgid()}", str(dest)], check=True)
    if not skip_build:
        msg.info("npm install + build in /opt/fitness...")
        subprocess.run(["npm", "install", "--silent"], cwd=dest, check=True)
        subprocess.run(["npm", "run", "build"], cwd=dest, check=True)

    # 4. Restart prod service
    msg.info("sudo systemctl restart fitness.service")
    r = subprocess.run(["sudo", "systemctl", "restart", "fitness.service"])
    if r.returncode == 0:
        msg.good("fitness.service restarted — deploy complete")
    else:
        msg.warn("fitness.service restart failed — check with: sudo systemctl status fitness.service")


# ── Internal ──────────────────────────────────────────────────────────────────

def _wait_healthy(node_url: Optional[str], python_url: Optional[str], timeout: int = 10):
    for _ in range(timeout):
        node_ok = not node_url or _http_ok(node_url)
        py_ok = not python_url or _http_ok(python_url)
        if node_ok and py_ok:
            msg.good("All services healthy")
            return
        time.sleep(1)
    msg.warn(f"Services not healthy after {timeout}s — check logs")


if __name__ == "__main__":
    app()
