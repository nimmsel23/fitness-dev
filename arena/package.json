{
  "name": "muscle-arena-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync:data": "node scripts/sync-data.mjs",
    "predev": "npm run sync:data",
    "prebuild": "npm run sync:data",
    "dev": "vite",
    "dev:clients": "vite --config vite.clients.config.mjs",
    "build": "vite build",
    "build:clients": "vite build --config vite.clients.config.mjs",
    "deploy:fitnessctx": "npm run build && node scripts/deploy-to-fitnessctx.mjs",
    "deploy:clients": "npm run build:clients && node scripts/deploy-clients-to-fitnessctx.mjs",
    "preview": "vite preview",
    "check:js": "node --check src/main.mjs && node --check src/skeleton-generator.mjs && node --check scripts/sync-data.mjs && node --check scripts/deploy-to-fitnessctx.mjs && node --check scripts/deploy-clients-to-fitnessctx.mjs && node --check vite.clients.config.mjs"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "alpinejs": "^3.15.8",
    "moment": "^2.30.1",
    "react": "^19.2.4",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^19.2.4"
  }
}
